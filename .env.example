# API Keys for LLM Services
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Market Data APIs
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# TradingView Webhook
TRADINGVIEW_WEBHOOK_SECRET=your_tradingview_webhook_secret_here
WEBHOOK_PUBLIC_URL=https://<your-static-domain>.ngrok-free.app/webhook/signal

# Alpaca Paper Trading
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Trading Parameters
TRADING_TICKERS=AAPL,MSFT,NVDA,SPY
MAX_POSITION_PERCENT=0.05
STOP_LOSS_PERCENT=0.02
TAKE_PROFIT_PERCENT=0.04
MAX_OPEN_POSITIONS=2
MAX_DRAWDOWN_PERCENT=0.10
INITIAL_PAPER_CASH=100000.0

# System Settings
DATABASE_PATH=trading_agent.db
CHROMA_PERSIST_DIR=chroma_db
LOG_FILE_PATH=trading_agent.log
TIMEZONE=Asia/Kolkata

# Safety Controls
LIVE_TRADING=false
DRY_RUN=true